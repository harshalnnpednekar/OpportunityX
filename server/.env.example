# =============================================================================
# OpportunityX — Backend Server Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env in server directory: cp server/.env.example server/.env

# Node Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port (defaults to 5000)
PORT=5000

# PostgreSQL Database Connection URL (development/production)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunityx

# PostgreSQL Test Database Connection URL (used during automated Jest test runs)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunityx_test

# Secret key used for signing and verifying JWT authentication tokens
# In production, use a cryptographically strong 256-bit random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Allowed Frontend Client Origin(s) for CORS headers
# Supports comma-separated list of origins for multiple deployment targets
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
