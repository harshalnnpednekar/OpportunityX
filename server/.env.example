# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Replace with your local or hosted PostgreSQL credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunityx
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunityx_test

# JWT Authentication Secret (Placeholder - replace with strong random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client Origin (For CORS - supports comma-separated list of origins)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
