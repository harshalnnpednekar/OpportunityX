{
  "name": "opportunityx-server",
  "version": "1.0.0",
  "description": "Backend API for OpportunityX - Student Opportunity Discovery Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node src/scripts/createDb.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:migrate:undo": "node src/scripts/migrate.js --undo",
    "db:reset": "node src/scripts/resetDb.js",
    "db:seed": "node src/seeders/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "node --check src/server.js src/app.js src/routes/index.js src/middleware/errorHandler.js src/middleware/requestLogger.js"
  },
  "keywords": [
    "opportunity-discovery",
    "education",
    "hackathons",
    "internships"
  ],
  "author": "OpportunityX Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "fast-xml-parser": "^4.5.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
