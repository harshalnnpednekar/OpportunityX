{
  "name": "opportunityx",
  "version": "1.0.0",
  "description": "OpportunityX - Full-Stack Student Opportunity Discovery Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm start --prefix server",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "test": "npm run test --prefix server",
    "test:server": "npm run test --prefix server",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "lint:server": "npm run lint --prefix server",
    "lint:client": "npm run lint --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshalnnpednekar/OpportunityX.git"
  },
  "keywords": [
    "opportunity-discovery",
    "full-stack",
    "react",
    "express",
    "vite"
  ],
  "author": "OpportunityX Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
