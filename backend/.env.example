# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Replace with your own PostgreSQL credentials)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
TEST_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<TEST_DB_NAME>

# JWT Authentication Secret (Generate a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Application Origin (For CORS)
CLIENT_URL=http://localhost:5173
