{
  "name": "opportunityx-backend",
  "version": "1.0.0",
  "description": "Backend API for OpportunityX - Student Opportunity Discovery Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/seeders/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
