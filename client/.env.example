# =============================================================================
# OpportunityX — Client Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env in client directory: cp client/.env.example client/.env

# Primary API Base URL accessed by browser client
# Local development with Vite proxy: /api
# Direct cross-origin / production API connection: https://opportunityx-api.onrender.com/api
VITE_API_BASE_URL=/api

# Backward compatibility alias
VITE_API_URL=/api

# Vite development proxy target (defaults to http://localhost:5000 if omitted)
# Used only by the Vite dev server to forward /api requests locally
VITE_PROXY_TARGET=http://localhost:5000
