# Vite Client Environment Configuration (Example)

# Backend API Base URL
# Option 1: Leave blank or set to '/api' to use Vite development proxy
VITE_API_URL=/api

# Option 2: Target Express backend server directly (or during production)
# VITE_API_URL=http://localhost:5000/api

# Vite dev proxy target (defaults to http://localhost:5000 if omitted)
VITE_PROXY_TARGET=http://localhost:5000
